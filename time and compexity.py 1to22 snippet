# --- Snippet 1 ---
def find_max(arr):
    # Time Complexity: O(n)
    # Space Complexity: O(1)
    # Justification: Single loop iterates through the array of size n once, using constant extra space.
    max_val = arr[0]
    for i in range(1, len(arr)):
        if arr[i] > max_val:
            max_val = arr[i]
    return max_val


# --- Snippet 2 ---
def has_duplicate(arr):
    # Time Complexity: O(n^2)
    # Space Complexity: O(1)
    # Justification: Nested loops compare each element with every other element, taking quadratic time and constant space.
    for i in range(len(arr)):
        for j in range(i + 1, len(arr)):
            if arr[i] == arr[j]:
                return True
    return False


# --- Snippet 3 ---
def sum_digits(n):
    # Time Complexity: O(log n)
    # Space Complexity: O(log n)
    # Justification: The function recursively divides the number by 10, creating a call stack proportional to the number of digits.
    if n == 0:
        return 0
    return n % 10 + sum_digits(n // 10)


# --- Snippet 4 ---
def print_pairs(arr):
    # Time Complexity: O(n^2)
    # Space Complexity: O(n^2)
    # Justification: Nested loops run n * n times to store all pairs in a result list of size n^2.
    n = len(arr)
    result = []
    for i in range(n):
        for j in range(n):
            result.append((arr[i], arr[j]))
    return result


# --- Snippet 5 ---
def binary_search(arr, target):
    # Time Complexity: O(log n)
    # Space Complexity: O(1)
    # Justification: Binary search divides the search space in half with each iteration, using constant extra space.
    low, high = 0, len(arr) - 1
    while low <= high:
        mid = (low + high) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    return -1


# --- Snippet 6 ---
def matrix_multiply(a, b):
    # Time Complexity: O(n^3)
    # Space Complexity: O(n^2)
    # Justification: Three nested loops of size n multiply two matrices, storing the n x n result matrix.
    n = len(a)
    result = [[0] * n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            for k in range(n):
                result[i][j] += a[i][k] * b[k][j]
    return result


# --- Snippet 7 ---
def to_sparse(matrix):
    # Time Complexity (in terms of dimensions m and n): O(m * n)
    # Space Complexity (in terms of k non-zero elements): O(k)
    # Justification: Nested loops iterate through all m x n matrix cells, and space stores only the k non-zero elements.
    triples = []
    for r in range(len(matrix)):
        for c in range(len(matrix[0])):
            if matrix[r][c] != 0:
                triples.append((r, c, matrix[r][c]))
    return triples


