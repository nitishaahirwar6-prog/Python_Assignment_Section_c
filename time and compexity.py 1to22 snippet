def process(arr):
    # Time Complexity: O(n^2)
    # Space Complexity: O(1)
    # Justification: Outer loop runs n times and the inner loop runs n times independently, totaling n^2 operations.
    n = len(arr)
    for i in range(n):
        print(arr[i])
        for j in range(n):
            print(arr[i], arr[j])


