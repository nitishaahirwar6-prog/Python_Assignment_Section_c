def check_first_ten(arr):
    # Time Complexity: O(n)
    # Space Complexity: O(1)
    # Justification: Outer loop runs n times while the inner loop runs a fixed 10 times (O(1)).
    for i in range(len(arr)):
        for j in range(10):
            if arr[i] == j:
                return True
    return False


