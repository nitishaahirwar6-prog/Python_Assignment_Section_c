def reverse_new(arr):
    # Time Complexity: O(n)
    # Space Complexity: O(n)
    # Justification: A single loop traverses the array of size n backwards, storing elements in a new list of size n.
    reversed_arr = []
    for i in range(len(arr) - 1, -1, -1):
        reversed_arr.append(arr[i])
    return reversed_arr


