def grade_calculator():
    last_student = None  # To store the most recently entered student's data

    while True:
        print("\n--- Student Grade Calculator Menu ---")
        print("1. Enter marks for a new student")
        print("2. View grade of last entered student")
        print("3. Exit")

        choice = input("Enter your choice (1-3): ")

        if choice == '1':
            name = input("Enter student name: ")
            marks = []
            for i in range(1, 6):
                m = float(input(f"Enter marks for subject {i} (out of 100): "))
                marks.append(m)
            
            avg = sum(marks) / 5
            
            # Grade assignment based on average
            if avg >= 90:
                grade = 'A'
            elif avg >= 75:
                grade = 'B'
            elif avg >= 60:
                grade = 'C'
            elif avg >= 40:
                grade = 'D'
            else:
                grade = 'F'
            
            last_student = {"name": name, "marks": marks, "average": avg, "grade": grade}
            print(f"Data saved successfully! Average: {avg:.2f}, Grade: {grade}")

        elif choice == '2':
            if last_student is None:
                print("No student data available yet.")
            else:
                print("\n--- Last Entered Student Details ---")
                print(f"Name: {last_student['name']}")
                print(f"Marks: {last_student['marks']}")
                print(f"Average: {last_student['average']:.2f}")
                print(f"Grade: {last_student['grade']}")

        elif choice == '3':
            print("Exiting Grade Calculator. Goodbye!")
            break
        else:
            print("Invalid choice! Please select 1, 2, or 3.")

if __name__ == "__main__":
    grade_calculator()